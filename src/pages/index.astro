---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StudioHero from '../components/StudioHero.astro';
import AppCard from '../components/AppCard.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { apps } from '../data/apps.js';
---
<Layout title="WazStudio — small apps, built with care">
	<Header />
	<main>
		<StudioHero />
		<section id="apps" class="mx-auto max-w-6xl px-6 py-24">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">The lineup</h2>
				<p class="mt-4 text-slate-600 dark:text-slate-400">Every app WazStudio has shipped, in one place.</p>
			</div>
			<div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{apps.map((app) => (
					<AppCard slug={app.slug} name={app.name} tagline={app.tagline} accent={app.accent} />
				))}
			</div>
		</section>
		<About />
	</main>
	<Footer />
</Layout>

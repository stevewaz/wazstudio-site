---
import AppStoreBadge from './AppStoreBadge.astro';

interface Props {
	name: string;
	tagline: string;
	accent: string;
	appStoreUrl: string;
}
const { name, tagline, accent, appStoreUrl } = Astro.props;
---
<section class="relative overflow-hidden">
	<div class="absolute inset-x-0 top-0 -z-10 h-[32rem] bg-gradient-to-b from-indigo-100 to-transparent dark:from-indigo-500/10"></div>
	<div class="mx-auto flex max-w-4xl flex-col items-center px-6 pt-20 pb-16 text-center sm:pt-28">
		<div
			class="flex h-16 w-16 items-center justify-center rounded-2xl text-2xl font-bold text-white shadow-lg"
			style={`background-color: ${accent}`}
		>
			{name.charAt(0)}
		</div>
		<h1 class="mt-6 text-4xl font-bold tracking-tight text-balance sm:text-6xl">{name}</h1>
		<p class="mt-6 max-w-2xl text-lg text-slate-600 text-balance dark:text-slate-400">{tagline}</p>
		<div class="mt-10">
			<AppStoreBadge href={appStoreUrl} />
		</div>
		<div class="mt-16 w-full">
			<div class="mx-auto aspect-video w-full max-w-3xl rounded-2xl border border-slate-200 bg-slate-100 shadow-2xl shadow-slate-900/10 dark:border-slate-800 dark:bg-slate-900">
				<div class="flex h-full items-center justify-center text-sm text-slate-400 dark:text-slate-600">
					App preview goes here
				</div>
			</div>
		</div>
	</div>
</section>

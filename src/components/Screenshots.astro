---
interface Props {
	shots: string[];
}
const { shots } = Astro.props;
---
<section id="screenshots" class="border-y border-slate-200 bg-slate-50 py-24 dark:border-slate-800 dark:bg-slate-900/40">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">A closer look</h2>
			<p class="mt-4 text-slate-600 dark:text-slate-400">A quick tour of what you'll actually see day to day.</p>
		</div>
		<div class="mt-16 grid gap-6 sm:grid-cols-3">
			{shots.map((shot) => (
				<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
					<div class="flex aspect-[9/16] items-center justify-center text-sm text-slate-400 dark:text-slate-600">
						{shot}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

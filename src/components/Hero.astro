---
---
<section class="relative overflow-hidden">
	<div class="absolute inset-x-0 top-0 -z-10 h-[32rem] bg-gradient-to-b from-indigo-100 to-transparent dark:from-indigo-500/10"></div>
	<div class="mx-auto flex max-w-4xl flex-col items-center px-6 pt-20 pb-16 text-center sm:pt-28">
		<span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-500 dark:border-slate-700 dark:text-slate-400">
			Built by one indie developer
		</span>
		<h1 class="mt-6 text-4xl font-bold tracking-tight text-balance sm:text-6xl">
			A small app that does <span class="text-indigo-500">one thing well.</span>
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-slate-600 text-balance dark:text-slate-400">
			No bloat, no subscriptions you forgot about, no dark patterns. Just a fast, focused
			tool designed to fit the way you already work.
		</p>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
			<a
				href="#download"
				class="rounded-full bg-indigo-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:bg-indigo-400"
			>
				Download for free
			</a>
			<a
				href="#screenshots"
				class="rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-500"
			>
				See it in action
			</a>
		</div>
		<div class="mt-16 w-full">
			<div class="mx-auto aspect-video w-full max-w-3xl rounded-2xl border border-slate-200 bg-slate-100 shadow-2xl shadow-slate-900/10 dark:border-slate-800 dark:bg-slate-900">
				<div class="flex h-full items-center justify-center text-sm text-slate-400 dark:text-slate-600">
					App preview goes here
				</div>
			</div>
		</div>
	</div>
</section>

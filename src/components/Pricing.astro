<section id="pricing" class="mx-auto max-w-6xl px-6 py-24">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Simple, honest pricing</h2>
		<p class="mt-4 text-slate-600 dark:text-slate-400">One price. No tiers to compare, no upsells later.</p>
	</div>
	<div class="mx-auto mt-16 max-w-sm rounded-2xl border border-slate-200 p-8 text-center shadow-sm dark:border-slate-800">
		<p class="text-sm font-medium text-slate-500 dark:text-slate-400">Full app, forever</p>
		<p class="mt-2 text-5xl font-bold tracking-tight">$9<span class="text-lg font-medium text-slate-400"> once</span></p>
		<ul class="mt-8 space-y-3 text-left text-sm text-slate-600 dark:text-slate-400">
			<li class="flex items-start gap-2">
				<span class="mt-0.5 text-indigo-500">✓</span> Every current feature
			</li>
			<li class="flex items-start gap-2">
				<span class="mt-0.5 text-indigo-500">✓</span> All future updates
			</li>
			<li class="flex items-start gap-2">
				<span class="mt-0.5 text-indigo-500">✓</span> Use on all your devices
			</li>
			<li class="flex items-start gap-2">
				<span class="mt-0.5 text-indigo-500">✓</span> Direct email support
			</li>
		</ul>
		<a
			href="#download"
			class="mt-8 block w-full rounded-full bg-indigo-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:bg-indigo-400"
		>
			Buy once, own it
		</a>
	</div>
</section>

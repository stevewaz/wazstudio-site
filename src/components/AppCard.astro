---
interface Props {
	slug: string;
	name: string;
	tagline: string;
	accent: string;
}
const { slug, name, tagline, accent } = Astro.props;
---
<a
	href={`${import.meta.env.BASE_URL}apps/${slug}/`}
	class="group flex flex-col rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-900/5 dark:border-slate-800"
>
	<div
		class="flex h-12 w-12 items-center justify-center rounded-xl text-lg font-bold text-white"
		style={`background-color: ${accent}`}
	>
		{name.charAt(0)}
	</div>
	<h3 class="mt-4 font-semibold">{name}</h3>
	<p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{tagline}</p>
	<span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-indigo-500">
		View app
		<span class="transition group-hover:translate-x-0.5">→</span>
	</span>
</a>

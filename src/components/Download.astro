---
import AppStoreBadge from './AppStoreBadge.astro';

interface Props {
	name: string;
	appStoreUrl: string;
}
const { name, appStoreUrl } = Astro.props;
---
<section id="download" class="mx-auto max-w-4xl px-6 pb-24">
	<div class="rounded-3xl bg-slate-900 px-8 py-16 text-center text-white dark:bg-white dark:text-slate-900">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Ready to try {name}?</h2>
		<p class="mx-auto mt-4 max-w-xl text-slate-300 dark:text-slate-600">
			Download it from the App Store and see for yourself.
		</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
			<AppStoreBadge href={appStoreUrl} />
		</div>
	</div>
</section>

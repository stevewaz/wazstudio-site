---
const faqs = [
	{
		q: 'Which platforms does it run on?',
		a: 'It works on desktop and mobile. Buy once and use it everywhere your account is signed in.',
	},
	{
		q: 'Is there a free trial?',
		a: 'Yes. Download it and use the core features free, no account required, no time limit.',
	},
	{
		q: "Who's behind this?",
		a: "One indie developer, not a company. Support emails go straight to the person who wrote the code.",
	},
	{
		q: 'How do I get help?',
		a: "Email support@wazstudio.app and you'll hear back directly, usually within a day.",
	},
];
---
<section id="faq" class="border-t border-slate-200 py-24 dark:border-slate-800">
	<div class="mx-auto max-w-3xl px-6">
		<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Frequently asked questions</h2>
		<div class="mt-12 divide-y divide-slate-200 dark:divide-slate-800">
			{faqs.map((item) => (
				<details class="group py-5">
					<summary class="flex cursor-pointer list-none items-center justify-between font-medium marker:content-none">
						{item.q}
						<span class="text-slate-400 transition group-open:rotate-45">+</span>
					</summary>
					<p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{item.a}</p>
				</details>
			))}
		</div>
	</div>
</section>
